DATA_DIR := "./data"
RAW_DATA := DATA_DIR / "01_raw"
INTERMEDIATE_DATA := DATA_DIR / "02_intermediate"
PRIMARY_DATA := DATA_DIR / "03_primary"
BUCKET := "s3://crib-assets-732401078342-ca-central-1-an"
DATA_ASSETS_PATH := BUCKET / "data"
DISTRIBUTION_ID := "E3GMH6GBO0IVNA"
AWS_PROFILE := env("AWS_PROFILE", "crib")

bioregions-to-json:
    gdal vector reproject -d epsg:4326 -f GeoJSON {{ INTERMEDIATE_DATA }}/marine_administrative_boundaries.gpkg {{ PRIMARY_DATA }}/bioregions.json

pmtiles:
    tippecanoe --force -zg -o {{ PRIMARY_DATA }}/mpas.pmtiles \
        -L '{"file": "{{ PRIMARY_DATA }}/mpas_indexed.json", "layer":"mpas"}' \
        -L '{"file": "{{ PRIMARY_DATA }}/bioregions.json", "layer":"bioregions"}'

# Climate risk classes of ClimVuln, from the Vulnerability thresholds (tlow,
# tmed, thigh) in 01_raw/thresholds_standardized.csv. Mirrors RISK_CLASSES in
# client/src/lib/risk-colormap.ts; colors are in conf/climate_risk_colors.txt.
# 0 nodata (the filled rasters' -9999), 1 negligible, 2 moderate, 3 high, 4 critical
VULN_RISK_CLASSES := "-9999=0; \
    [0,0.2345909125689)=1; \
    [0.2345909125689,0.443899021417284)=2; \
    [0.443899021417284,0.650018122866379)=3; \
    [0.650018122866379,inf)=4"

# Classify band 19 (ClimVuln) of a filled raster into a paletted COG.
# nodata is cleared before reclassify and set after it: inside a pipeline, a
# later edit --nodata is already applied when the mapping is evaluated.
classify-vulnerability input output:
    gdal raster pipeline \
      ! read {{ input }} \
      ! select --band 19 \
      ! edit --nodata none \
      ! reclassify --ot Byte --mapping "{{ VULN_RISK_CLASSES }}" \
      ! edit --nodata 0 --color-map conf/climate_risk_colors.txt \
      ! write -f COG --co COMPRESS=DEFLATE --co RESAMPLING=NEAREST --co TILING_SCHEME=GoogleMapsCompatible --co ZOOM_LEVEL_STRATEGY=UPPER --overwrite {{ output }}


sync-data-cdn:
    aws s3 sync {{ PRIMARY_DATA }} {{ DATA_ASSETS_PATH }} --profile {{ AWS_PROFILE }} \
        --exclude "*" --include "*_cog.tif" --exclude "*/*" \
        --content-type "image/tiff; application=geotiff; profile=cloud-optimized" \
        --cache-control "public, max-age=86400, s-maxage=86400"
    aws s3 sync {{ PRIMARY_DATA }} {{ DATA_ASSETS_PATH }} --profile {{ AWS_PROFILE }} \
        --exclude "*" --include "*.pmtiles" --exclude "*/*" \
        --content-type "application/vnd.pmtiles" \
        --cache-control "public, max-age=300, s-maxage=86400"
    aws s3 sync {{ PRIMARY_DATA }} {{ DATA_ASSETS_PATH }} --profile {{ AWS_PROFILE }} \
        --exclude "*" --include "*.parquet" --exclude "*/*" \
        --content-type "application/vnd.apache.parquet" \
        --cache-control "public, max-age=300, s-maxage=86400"
    aws s3 sync {{ PRIMARY_DATA }}/species_climvuln {{ DATA_ASSETS_PATH }}/species_climvuln --profile {{ AWS_PROFILE }} \
        --exclude "*" --include "*_cog.tif" \
        --content-type "image/tiff; application=geotiff; profile=cloud-optimized" \
        --cache-control "public, max-age=86400, s-maxage=86400"

invalidate-cache:
    aws cloudfront create-invalidation --distribution-id {{ DISTRIBUTION_ID }} \
        --paths "/*" --profile {{ AWS_PROFILE }}

publish: sync-data-cdn invalidate-cache

contours dem out:
    gdal pipeline \
      ! calc --input A={{ dem }} --calc "A<0?-A:NODATA" --ot Float32 \
      ! resize --size 25%,25% --resampling average \
      ! neighbors --kernel gaussian --size 5 \
      ! tee [ write smoothed_depth.tif --overwrite ] \
      ! contour --levels 50,100,200,1000,2000,4000 --elevation-name depth \
      ! write {{ out }} --overwrite

# Append a `contours` layer to an existing pmtiles (tippecanoe can't append in place, so build + tile-join)
append-contours contours target:
    tippecanoe --force -o /tmp/contours.pmtiles -l contours -zg \
        --simplification=10 --simplification-at-maximum-zoom=1 --visvalingam \
        --drop-densest-as-needed --extend-zooms-if-still-dropping \
        {{ contours }}
    tile-join --force --no-tile-size-limit -o /tmp/joined.pmtiles {{ target }} /tmp/contours.pmtiles
    mv /tmp/joined.pmtiles {{ target }}
